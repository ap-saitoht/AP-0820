<?xml version="1.0" encoding="utf-8"?>
<setup>
	<!-- BLEデバイス名 -->
	<devicename>AP-0820</devicename>

	<!-- 出力ファイルパス -->
	<filepath>output.txt</filepath>

	<!-- 読み取りコマンド -->
	<readcmd>F1</readcmd>

	<!-- 読み取り間隔（s） -->
	<interval>1</interval>

	<!-- コマンド リトライ回数 -->
	<retry>5</retry>

	<!-- 読み取りデータ デコード（"utf-8"、"shift_jis"他） -->
	<datadec>shift_jis</datadec>

	<!-- 処理終了データ -->
	<enddata>99999999</enddata>
</setup>
